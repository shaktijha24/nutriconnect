# MongoDB connection string (MongoDB Atlas free tier works great)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nutriconnect?retryWrites=true&w=majority

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# The admin account is created automatically on first start with these credentials
ADMIN_EMAIL=admin@nutriconnect.com
ADMIN_PASSWORD=Admin@12345

# Optional: Razorpay TEST keys. If empty, the app uses a built-in demo payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Google Sign-In (free). OAuth Client ID from console.cloud.google.com.
# If empty, the "Continue with Google" button is simply hidden.
GOOGLE_CLIENT_ID=

# Optional: days between a suspension and its hearing (default 5).
# For quick testing you can set e.g. 0.002 (about 3 minutes).
HEARING_DELAY_DAYS=5
